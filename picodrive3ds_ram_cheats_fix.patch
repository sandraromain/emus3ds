diff --git a/src/3ds/gpu_compat.h b/src/3ds/gpu_compat.h
new file mode 100644
--- /dev/null
+++ b/src/3ds/gpu_compat.h
@@ -0,0 +1,501 @@
+#ifndef EMUS3DS_GPU_COMPAT_H
+#define EMUS3DS_GPU_COMPAT_H
+
+/*
+ * Compatibility layer for the legacy ctrulib GPU API used by emus3ds.
+ * The register-level helpers below are based on the old ctrulib API and
+ * the compatibility implementation retained by RetroArch.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <3ds.h>
+
+static inline void GPU_Init(Handle *gsphandle)
+{
+    (void)gsphandle;
+    GPUCMD_SetBuffer(NULL, 0, 0);
+}
+
+static inline void GPU_Reset(u32 *gxbuf, u32 *gpuBuf, u32 gpuBufSize)
+{
+    (void)gxbuf;
+    GPUCMD_SetBuffer(gpuBuf, gpuBufSize, 0);
+}
+
+static inline void GPU_SetFloatUniform(
+    GPU_SHADER_TYPE type, u32 startreg, u32 *data, u32 numreg)
+{
+    int regOffset = 0;
+
+    if (!data)
+        return;
+
+    if (type == GPU_GEOMETRY_SHADER)
+        regOffset = -0x30;
+
+    GPUCMD_AddWrite(
+        GPUREG_VSH_FLOATUNIFORM_CONFIG + regOffset,
+        0x80000000 | startreg);
+    GPUCMD_AddWrites(
+        GPUREG_VSH_FLOATUNIFORM_DATA + regOffset,
+        data,
+        numreg * 4);
+}
+
+static inline void GPU_SetViewport(
+    u32 *depthBuffer, u32 *colorBuffer,
+    u32 x, u32 y, u32 w, u32 h)
+{
+    u32 f116e;
+    u32 param[4];
+    float fw = (float)w;
+    float fh = (float)h;
+
+    GPUCMD_AddWrite(GPUREG_FRAMEBUFFER_FLUSH, 0x00000001);
+    GPUCMD_AddWrite(GPUREG_FRAMEBUFFER_INVALIDATE, 0x00000001);
+
+    f116e = 0x01000000 |
+        (((h - 1) & 0xFFF) << 12) |
+        (w & 0xFFF);
+
+    param[0] = ((u32)depthBuffer) >> 3;
+    param[1] = ((u32)colorBuffer) >> 3;
+    param[2] = f116e;
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_DEPTHBUFFER_LOC, param, 3);
+
+    GPUCMD_AddWrite(GPUREG_RENDERBUF_DIM, f116e);
+    GPUCMD_AddWrite(GPUREG_DEPTHBUFFER_FORMAT, 0x00000003);
+    GPUCMD_AddWrite(GPUREG_COLORBUFFER_FORMAT, 0x00000002);
+    GPUCMD_AddWrite(GPUREG_FRAMEBUFFER_BLOCK32, 0x00000000);
+
+    param[0] = f32tof24(fw / 2);
+    param[1] = f32tof31(2.0f / fw) << 1;
+    param[2] = f32tof24(fh / 2);
+    param[3] = f32tof31(2.0f / fh) << 1;
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_VIEWPORT_WIDTH, param, 4);
+
+    GPUCMD_AddWrite(
+        GPUREG_VIEWPORT_XY,
+        (y << 16) | (x & 0xFFFF));
+
+    param[0] = 0;
+    param[1] = 0;
+    param[2] = ((h - 1) << 16) | ((w - 1) & 0xFFFF);
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_SCISSORTEST_MODE, param, 3);
+
+    param[0] = 0x0000000F;
+    param[1] = 0x0000000F;
+    param[2] = 0x00000002;
+    param[3] = 0x00000002;
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_COLORBUFFER_READ, param, 4);
+}
+
+static inline void GPU_SetScissorTest(
+    GPU_SCISSORMODE mode,
+    u32 left, u32 bottom, u32 right, u32 top)
+{
+    u32 param[3];
+
+    param[0] = mode;
+    param[1] = (bottom << 16) | (left & 0xFFFF);
+    param[2] = ((top - 1) << 16) | ((right - 1) & 0xFFFF);
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_SCISSORTEST_MODE, param, 3);
+}
+
+static inline void GPU_DepthMap(float zScale, float zOffset)
+{
+    GPUCMD_AddWrite(GPUREG_DEPTHMAP_ENABLE, 1);
+    GPUCMD_AddWrite(GPUREG_DEPTHMAP_SCALE, f32tof24(zScale));
+    GPUCMD_AddWrite(GPUREG_DEPTHMAP_OFFSET, f32tof24(zOffset));
+}
+
+static inline void GPU_SetAlphaTest(
+    bool enable, GPU_TESTFUNC function, u8 ref)
+{
+    GPUCMD_AddWrite(
+        GPUREG_FRAGOP_ALPHA_TEST,
+        (enable & 1) | ((function & 7) << 4) | (ref << 8));
+}
+
+static inline void GPU_SetStencilTest(
+    bool enable, GPU_TESTFUNC function,
+    u8 ref, u8 input_mask, u8 write_mask)
+{
+    GPUCMD_AddWrite(
+        GPUREG_STENCIL_TEST,
+        (enable & 1) |
+        ((function & 7) << 4) |
+        (write_mask << 8) |
+        (ref << 16) |
+        (input_mask << 24));
+}
+
+static inline void GPU_SetStencilOp(
+    GPU_STENCILOP sfail,
+    GPU_STENCILOP dfail,
+    GPU_STENCILOP pass)
+{
+    GPUCMD_AddWrite(
+        GPUREG_STENCIL_OP,
+        sfail | (dfail << 4) | (pass << 8));
+}
+
+static inline void GPU_SetDepthTestAndWriteMask(
+    bool enable,
+    GPU_TESTFUNC function,
+    GPU_WRITEMASK writemask)
+{
+    GPUCMD_AddWrite(
+        GPUREG_DEPTH_COLOR_MASK,
+        (enable & 1) |
+        ((function & 7) << 4) |
+        (writemask << 8));
+}
+
+static inline void GPU_SetFaceCulling(GPU_CULLMODE mode)
+{
+    GPUCMD_AddWrite(
+        GPUREG_FACECULLING_CONFIG,
+        mode & 0x3);
+}
+
+static inline void GPU_SetAlphaBlending(
+    GPU_BLENDEQUATION colorEquation,
+    GPU_BLENDEQUATION alphaEquation,
+    GPU_BLENDFACTOR colorSrc,
+    GPU_BLENDFACTOR colorDst,
+    GPU_BLENDFACTOR alphaSrc,
+    GPU_BLENDFACTOR alphaDst)
+{
+    GPUCMD_AddWrite(
+        GPUREG_BLEND_FUNC,
+        colorEquation |
+        (alphaEquation << 8) |
+        (colorSrc << 16) |
+        (colorDst << 20) |
+        (alphaSrc << 24) |
+        (alphaDst << 28));
+
+    GPUCMD_AddMaskedWrite(
+        GPUREG_COLOR_OPERATION,
+        0x2,
+        0x00000100);
+}
+
+static inline void GPU_SetBlendingColor(
+    u8 r, u8 g, u8 b, u8 a)
+{
+    GPUCMD_AddWrite(
+        GPUREG_BLEND_COLOR,
+        r | (g << 8) | (b << 16) | (a << 24));
+}
+
+static inline void GPU_SetTextureEnable(GPU_TEXUNIT units)
+{
+    GPUCMD_AddMaskedWrite(
+        GPUREG_SH_OUTATTR_CLOCK,
+        0x2,
+        units << 8);
+
+    GPUCMD_AddWrite(
+        GPUREG_TEXUNIT_CONFIG,
+        0x00011000 | units);
+}
+
+static inline void GPU_SetTexture(
+    GPU_TEXUNIT unit,
+    u32 *data,
+    u16 width,
+    u16 height,
+    u32 param,
+    GPU_TEXCOLOR colorType)
+{
+    switch (unit)
+    {
+        case GPU_TEXUNIT0:
+            GPUCMD_AddWrite(GPUREG_TEXUNIT0_TYPE, colorType);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT0_ADDR1, ((u32)data) >> 3);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT0_DIM, (width << 16) | height);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT0_PARAM, param);
+            break;
+
+        case GPU_TEXUNIT1:
+            GPUCMD_AddWrite(GPUREG_TEXUNIT1_TYPE, colorType);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT1_ADDR, ((u32)data) >> 3);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT1_DIM, (width << 16) | height);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT1_PARAM, param);
+            break;
+
+        case GPU_TEXUNIT2:
+            GPUCMD_AddWrite(GPUREG_TEXUNIT2_TYPE, colorType);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT2_ADDR, ((u32)data) >> 3);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT2_DIM, (width << 16) | height);
+            GPUCMD_AddWrite(GPUREG_TEXUNIT2_PARAM, param);
+            break;
+    }
+}
+
+static inline void GPU_SetTextureBorderColor(
+    GPU_TEXUNIT unit, u32 borderColor)
+{
+    switch (unit)
+    {
+        case GPU_TEXUNIT0:
+            GPUCMD_AddWrite(
+                GPUREG_TEXUNIT0_BORDER_COLOR,
+                borderColor);
+            break;
+
+        case GPU_TEXUNIT1:
+            GPUCMD_AddWrite(
+                GPUREG_TEXUNIT1_BORDER_COLOR,
+                borderColor);
+            break;
+
+        case GPU_TEXUNIT2:
+            GPUCMD_AddWrite(
+                GPUREG_TEXUNIT2_BORDER_COLOR,
+                borderColor);
+            break;
+    }
+}
+
+static const u8 EMUS3DS_GPU_FORMATSIZE[4] = {1, 1, 2, 4};
+
+static inline void GPU_SetAttributeBuffers(
+    u8 totalAttributes,
+    u32 *baseAddress,
+    u64 attributeFormats,
+    u16 attributeMask,
+    u64 attributePermutation,
+    u8 numBuffers,
+    u32 bufferOffsets[],
+    u64 bufferPermutations[],
+    u8 bufferNumAttributes[])
+{
+    int i;
+    int j;
+    u32 param[0x28];
+    u8 sizeTable[0xC];
+
+    memset(param, 0, sizeof(param));
+    memset(sizeTable, 0, sizeof(sizeTable));
+
+    param[0] = ((u32)baseAddress) >> 3;
+    param[1] = attributeFormats & 0xFFFFFFFF;
+    param[2] =
+        ((totalAttributes - 1) << 28) |
+        ((attributeMask & 0xFFF) << 16) |
+        ((attributeFormats >> 32) & 0xFFFF);
+
+    for (i = 0; i < totalAttributes; i++)
+    {
+        u8 v = attributeFormats & 0xF;
+        sizeTable[i] =
+            EMUS3DS_GPU_FORMATSIZE[v & 3] *
+            ((v >> 2) + 1);
+        attributeFormats >>= 4;
+    }
+
+    for (i = 0; i < numBuffers; i++)
+    {
+        u16 stride = 0;
+
+        param[3 * (i + 1) + 0] = bufferOffsets[i];
+        param[3 * (i + 1) + 1] =
+            bufferPermutations[i] & 0xFFFFFFFF;
+
+        for (j = 0; j < bufferNumAttributes[i]; j++)
+        {
+            stride += sizeTable[
+                (bufferPermutations[i] >> (4 * j)) & 0xF];
+        }
+
+        param[3 * (i + 1) + 2] =
+            (bufferNumAttributes[i] << 28) |
+            ((stride & 0xFFF) << 16) |
+            ((bufferPermutations[i] >> 32) & 0xFFFF);
+    }
+
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_ATTRIBBUFFERS_LOC,
+        param,
+        0x27);
+
+    GPUCMD_AddMaskedWrite(
+        GPUREG_VSH_INPUTBUFFER_CONFIG,
+        0xB,
+        0xA0000000 | (totalAttributes - 1));
+
+    GPUCMD_AddWrite(
+        GPUREG_VSH_NUM_ATTR,
+        totalAttributes - 1);
+
+    u32 permutation[2] = {
+        (u32)(attributePermutation & 0xFFFFFFFF),
+        (u32)((attributePermutation >> 32) & 0xFFFF)
+    };
+
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_VSH_ATTRIBUTES_PERMUTATION_LOW,
+        permutation,
+        2);
+}
+
+static inline void GPU_SetTexEnv(
+    u8 id,
+    u16 rgbSources,
+    u16 alphaSources,
+    u16 rgbOperands,
+    u16 alphaOperands,
+    GPU_COMBINEFUNC rgbCombine,
+    GPU_COMBINEFUNC alphaCombine,
+    u32 constantColor)
+{
+    static const u8 tevid[] = {
+        0xC0, 0xC8, 0xD0, 0xD8, 0xF0, 0xF8
+    };
+
+    u32 param[5];
+
+    if (id >= 6)
+        return;
+
+    param[0] = (alphaSources << 16) | rgbSources;
+    param[1] = (alphaOperands << 12) | rgbOperands;
+    param[2] = (alphaCombine << 16) | rgbCombine;
+    param[3] = constantColor;
+    param[4] = 0;
+
+    GPUCMD_AddIncrementalWrites(
+        GPUREG_0000 | tevid[id],
+        param,
+        5);
+}
+
+static inline void GPU_DrawArray(
+    GPU_Primitive_t primitive,
+    u32 first,
+    u32 count)
+{
+    GPUCMD_AddMaskedWrite(
+        GPUREG_PRIMITIVE_CONFIG,
+        0x2,
+        primitive);
+
+    GPUCMD_AddMaskedWrite(
+        GPUREG_RESTART_PRIMITIVE,
+        0x2,
+        0x00000001);
+
+    GPUCMD_AddWrite(
+        GPUREG_INDEXBUFFER_CONFIG,
+        0x80000000);
+
+    GPUCMD_AddWrite(
+        GPUREG_NUMVERTICES,
+        count);
+
+    GPUCMD_AddWrite(
+        GPUREG_VERTEX_OFFSET,
+        first);
+
+    GPUCMD_AddMaskedWrite(
+        GPUREG_GEOSTAGE_CONFIG2,
+        0x1,
+        0x00000001);
+
+    GPUCMD_AddMaskedWrite(
+        GPUREG_START_DRAW_FUNC0,
+        0x1,
+        0x00000000);
+
+    GPUCMD_AddWrite(
+        GPUREG_DRAWARRAYS,
+        0x00000001);
+
+    GPUCMD_AddMaskedWrite(
+        GPUREG_START_DRAW_FUNC0,
+        0x1,
+        0x00000001);
+
+    GPUCMD_AddWrite(
+        GPUREG_VTX_FUNC,
+        0x00000001);
+
+    GPUCMD_AddWrite(
+        GPUREG_FRAMEBUFFER_FLUSH,
+        0x00000001);
+}
+
+static inline void GPUCMD_Finalize(void)
+{
+    GPUCMD_AddMaskedWrite(
+        GPUREG_PRIMITIVE_CONFIG,
+        0x8,
+        0x00000000);
+
+    GPUCMD_AddWrite(
+        GPUREG_FRAMEBUFFER_FLUSH,
+        0x00000001);
+
+    GPUCMD_AddWrite(
+        GPUREG_FRAMEBUFFER_INVALIDATE,
+        0x00000001);
+
+    GPUCMD_AddWrite(
+        GPUREG_FINALIZE,
+        0x12345678);
+
+    GPUCMD_AddWrite(
+        GPUREG_FINALIZE,
+        0x12345678);
+}
+
+extern u32 __ctru_linear_heap;
+extern u32 __ctru_linear_heap_size;
+
+static inline void GPUCMD_FlushAndRun(void)
+{
+    u32 *buf = NULL;
+    u32 size = 0;
+    u32 offset = 0;
+
+    GPUCMD_GetBuffer(&buf, &size, &offset);
+    (void)size;
+
+    GX_FlushCacheRegions(
+        buf,
+        offset * 4,
+        (u32 *)__ctru_linear_heap,
+        __ctru_linear_heap_size,
+        NULL,
+        0);
+
+    GX_ProcessCommandList(
+        buf,
+        offset * 4,
+        0);
+}
+
+static inline bool emus3dsCheckNew3DS(void)
+{
+    u32 cmdbuf[16];
+    memset(cmdbuf, 0, sizeof(cmdbuf));
+
+    cmdbuf[0] = IPC_MakeHeader(0x102, 0, 0);
+
+    Result ret = aptSendCommand(cmdbuf);
+    if (R_FAILED(ret))
+        return false;
+
+    return (cmdbuf[2] & 0xFF) != 0;
+}
+
+#endif
